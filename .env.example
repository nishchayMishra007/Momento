# Copy this file to .env and fill in real values.
# Load it from the backend with dotenv (path: ../.env from backend/, or project root).

# PostgreSQL connection string used by the backend (pg) and by dbmate
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clipping?sslmode=disable

# Google Gemini API key (get one from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend server
PORT=4000

# Frontend: URL of the Express API (used by Next.js to call the backend)
NEXT_PUBLIC_API_URL=http://localhost:4000
